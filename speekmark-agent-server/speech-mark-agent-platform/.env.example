# 第一阶段：SQLite + 不启动 Redis。默认无需修改即可本地开发。
GO_PORT=8080
GIN_MODE=debug
APP_ENV=development
DATABASE_DRIVER=sqlite
SQLITE_PATH=./data/agent_platform.db
AGENT_BASE_URL=http://localhost:8000
AGENT_PORT=8000
PYTHONUNBUFFERED=1
LOG_LEVEL=INFO
MODEL_ENABLED=false
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TEMPERATURE=0.2
DEEPSEEK_TIMEOUT_SECONDS=60
LOG_LEVEL=INFO
VITE_API_BASE_URL=/api
VITE_USE_MOCK=false
VITE_APP_NAME=语音标注智能体工作台

# 后续切换 MySQL/Redis 时再启用以下配置：
# MYSQL_DSN=agent:password@tcp(mysql:3306)/agent_platform?charset=utf8mb4&parseTime=True&loc=Local
# REDIS_ADDR=redis:6379
# REDIS_PASSWORD=dev_redis_password
# REDIS_DB=0
