# 环境变量模板。使用时复制为 .env 并填入真实值：cp .env.example .env
# 变量按「大写+下划线」映射到 app/core/config.py 的 Settings，大小写不敏感。
# 注意：服务必须在 backend/ 目录下启动，.env 才会被正确加载。
# .env 已被 .gitignore 忽略，严禁把真实密钥写进本模板或提交到仓库。

# ---- 基础 ----
APP_ENV=development              # 运行环境：development / test / production
APP_NAME=Annotation Ops Agent    # 应用名称
APP_SECRET_KEY=                  # JWT 等签名密钥，生产必须填强随机值，切勿留空
LOG_LEVEL=INFO                   # 日志级别：DEBUG / INFO / WARNING / ERROR

# ---- 数据库 ----
DATABASE_URL=sqlite+aiosqlite:///./data/app.db   # 异步 SQLite，默认落在 backend/data/

# ---- LLM ----
LLM_PROVIDER=deepseek            # 模型供应商
DEEPSEEK_API_KEY=                # DeepSeek 密钥，调用模型时必填
DEEPSEEK_BASE_URL=https://api.deepseek.com       # DeepSeek 接口地址
DEEPSEEK_MODEL=deepseek-chat     # 模型名
LLM_TIMEOUT_SECONDS=60           # 单次模型调用超时（秒）
LLM_MAX_RETRIES=2                # 可重试错误的额外重试次数
LLM_TEMPERATURE=0.2              # 采样温度
LLM_MAX_TOKENS=1024              # 单次回答最大 token
LLM_CONTEXT_MESSAGES=20          # 组装上下文时最多带多少条历史消息

# ---- 业务侧（Go 标注平台）只读接口 ----
ANNOTATION_API_BASE_URL=         # 标注平台接口根地址
AGENT_SERVICE_ID=                # Agent 服务身份
AGENT_SERVICE_SECRET=            # Agent 服务密钥
ANNOTATION_API_TIMEOUT_SECONDS=10  # 调用业务接口超时（秒）

# ---- 跨域 ----
# 前端地址，必须写成 JSON 数组字符串
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
