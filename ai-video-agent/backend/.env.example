# ---------- 应用 ----------
APP_ENV=local                # local | test | production；production 下会关闭调试类接口
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
# 允许跨域的前端地址，逗号分隔
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------- 数据库 ----------
# 本地 SQLite；线上换成 postgresql+psycopg://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_URL=sqlite:///./data/ai_video_studio.db
# 启动时自动建表/升级（alembic upgrade head）。线上建议 false，由发布流程执行迁移
AUTO_MIGRATE=true

# ---------- Redis（可选，首期未使用，仅预留） ----------
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379/0

# ---------- 视频生成 Provider：这里只放连接与密钥 ----------
# 工作流 ID、请求字段名、视频方向、seed、时长上限等“生成配置”跟着账号类型存在数据库里，
# 在页面「账号设置」里修改；提示词模板在「提示词模板」里修改。
# fake：仅用于开发/测试，产出的不是真实视频；autodl：真实调用 AutoDL ComfyUI
VIDEO_PROVIDER=fake

AUTODL_BASE_URL=https://autodl.art
# Token 获取：https://autodl.art/large-model/tokens ；只放在后端 .env，不要提交到 Git
AUTODL_API_TOKEN=
# 认证头：官方示例直接把 Token 放在 Authorization，不带 Bearer
AUTODL_AUTH_HEADER=Authorization
AUTODL_AUTH_PREFIX=
# 路径模板；{workflow_id} / {task_id} 会被替换
AUTODL_SUBMIT_PATH=/api/v1/comfyui/comfyui_workflow/{workflow_id}
AUTODL_RESULT_PATH=/api/v1/comfyui/comfyui_workflow/result/{task_id}
# 仅在首次写入出厂数据时，作为“女性向情感治愈类”工作流 ID 的默认值；之后以数据库为准
AUTODL_WORKFLOW_ID=
# 图片传给 AutoDL 的方式：base64（内联）| url（需要 AutoDL 能访问 PUBLIC_BASE_URL）
AUTODL_IMAGE_MODE=base64
# 允许下载结果视频的额外域名（逗号分隔）；AUTODL_BASE_URL 的域名默认允许
AUTODL_RESULT_ALLOWED_HOSTS=
AUTODL_REQUEST_TIMEOUT_SECONDS=30
AUTODL_DOWNLOAD_TIMEOUT_SECONDS=300

# ---------- Worker ----------
# 本地开发让 API 进程内嵌一个 Worker；线上请设为 false 并单独运行 python -m app.workers.video_worker
WORKER_EMBEDDED=true
WORKER_IDLE_SLEEP_SECONDS=2
# 任务租约时长：Worker 崩溃后，超过该时间任务可被其他 Worker 接管
WORKER_LEASE_SECONDS=120
AUTODL_POLL_INTERVAL_SECONDS=5
AUTODL_POLL_MAX_INTERVAL_SECONDS=30
# 从开始执行起的最长等待时间
AUTODL_MAX_POLL_SECONDS=1800
# 提交阶段遇到“确定未到达服务端”的网络错误时的最大自动重试次数
SUBMIT_MAX_RETRIES=2
# 用户手动 retry 的次数上限
TASK_MAX_RETRIES=3

# ---------- 夜间生成窗口 ----------
# AutoDL 夜间更便宜。标记为“夜间生成”的任务只会在窗口内提交；已提交的任务不受窗口限制，会继续轮询。
TIMEZONE=Asia/Shanghai
GENERATION_WINDOW_ENABLED=true
GENERATION_WINDOW_START=23:00
GENERATION_WINDOW_END=07:00
# 同时在 GPU 上运行的任务数上限。创建任务（白天夜间都可以）不受限，超出的在后台排队
GENERATION_MAX_INFLIGHT=3

# ---------- 文本 LLM（场景提示词 / 对话文案） ----------
# fake：开发测试用，返回固定内容；deepseek：真实调用
LLM_PROVIDER=fake
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
PIPELINE_LEASE_SECONDS=300

# ---------- 存储与限制 ----------
LOCAL_STORAGE_DIR=./storage
PUBLIC_BASE_URL=http://127.0.0.1:8000
MAX_UPLOAD_BYTES=10485760
MAX_RESULT_BYTES=524288000
MAX_PROMPT_LENGTH=20000
# 手动创建任务时允许同时排队/进行中的任务总数
MAX_ACTIVE_TASKS=50
